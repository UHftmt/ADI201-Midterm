  "cases": [
    {
      "name": "happy_path_full_visit",
      "type": "happy_path",
      "input": [
        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "V-1",
            "client": "client-a",
            "service_id": "S1",
            "stylist": "Ana",
            "start": "2026-11-03 09:00"
          }
        },
        {
          "do": "move",
          "as": "staff",
          "item": 1,
          "to": "confirmed"
        },
        {
          "do": "move",
          "as": "staff",
          "item": 1,
          "to": "arrived"
        },
        {
          "do": "move",
          "as": "staff",
          "item": 1,
          "to": "completed"
        }
      ],
      "expected": {
        "outcome": "illegal_move",
        "state": "confirmed"
      },
      "how_computed": "9:00am + 45m = 9:45am"
    },
