{
  "cases": [
    {
      "name": "happy_path_full_visit",
      "type": "happy_path",
      "input": [
        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "V-1",
            "client": "client-a",
            "service_id": "S1",
            "stylist": "Ana",
            "start": "2026-11-03 09:00"
          }
        },
        {
          "do": "move",
          "as": "staff",
          "item": 1,
          "to": "confirmed"
        },
        {
          "do": "move",
          "as": "staff",
          "item": 1,
          "to": "arrived"
        },
        {
          "do": "move",
          "as": "staff",
          "item": 1,
          "to": "completed"
        }
      ],
      "expected": {
        "outcome": "accepted",
        "state": "completed"
      },
      "how_computed": "Because it's the process. The service is not overlap with any other services, for the service to be completed it has to be confirmed, customer must arrive and then completed."
    },
    {
      "name": "client_cannot_confirm",
      "type": "role_not_allowed",
      "input": [
        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "V-1",
            "client": "client-a",
            "service_id": "S1",
